# Parent directory containing isic_2018_1/, isic_2016_1/, and PH2Dataset/.
ML_DATA_ROOT=/absolute/path/to/data

# Directory used for checkpoints and evaluation reports.
ML_DATA_OUTPUT=/absolute/path/to/output
ML_DATA_OUTPUT_LOCAL=/absolute/path/to/output

# Optional experiment tracking. Leave WANDB_API_KEY unset after `wandb login`.
WANDB_MODE=offline
WANDB_DIR=/absolute/path/to/wandb
# WANDB_API_KEY=

TOPODISTILL_DATASET=isic_2018_1
TOPODISTILL_SEED=932
TOPODISTILL_PMASK_SUBDIR=pmasks
TOPODISTILL_PSEUDO_WEIGHT=1.0
TOPODISTILL_PSEUDO_WARMUP_EPOCHS=20
TOPODISTILL_BOUNDARY_IGNORE_RADIUS=2
TOPODISTILL_WANDB_VIS_EPOCH_INTERVAL=25
TOPODISTILL_ENABLE_GT_MONITOR=false
